<script>
const kunci = ['B', 'A', 'B', 'A', 'A', 'B', 'A', 'A', 'B', 'A', 'B', 'A', 'A', 'A', 'B', 'A', 'A', 'A', 'A', 'A', 'A', 'A', 'A', 'A', 'A'];
const isianKunci = ['dunia', 'browser', 'google', 'orang lain', 'URL'];
function hitung(){
  let benar=0, terjawab=0;
  for(let i=1;i<=25;i++){
    const pilih=document.querySelector('input[name="q'+i+'"]:checked');
    if(pilih){terjawab++; if(pilih.value===kunci[i-1]) benar++;}
  }
  let isianBenar=0, isianTerjawab=0;
  for(let i=1;i<=5;i++){
    const el=document.getElementById('isian'+i);
    if(el.value.trim()){isianTerjawab++; if(el.value.trim().toLowerCase()===isianKunci[i-1]) isianBenar++;}
  }
  const totalBenar=benar+isianBenar, total=30;
  const nilai=Math.round(totalBenar/total*100);
  const hasil=document.getElementById('result');
  hasil.style.display='block';
  hasil.innerHTML='<b>HASIL TES</b><br><br>PG benar: '+benar+' dari 25 soal<br>Isian benar: '+isianBenar+' dari 5 soal<br>Terjawab: '+(terjawab+isianTerjawab)+' dari 30 soal<br><br><b>Nilai: '+nilai+'</b>';
  window.scrollTo({top:document.body.scrollHeight,behavior:'smooth'});
}
</script>
